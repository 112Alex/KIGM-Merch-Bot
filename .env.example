BOT_TOKEN=your_bot_token_here
# Example DB URL for PostgreSQL (from docker-compose)
KIGM_MERCH_DB=postgresql+asyncpg://postgres:password@db:5432/kigm_merch_db

# Get it from your ngrok dashboard: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# --- Admin & Owner Settings ---
# The main owner of the bot (your personal Telegram ID)
OWNER_ID=0000000000
# Optional: comma-separated list of other admin Telegram IDs
ADMIN_IDS=0000000000,1111111111
# URL for the Admin Web App (MUST be HTTPS)
# For local dev, use a tunnel like ngrok: https://your-ngrok-subdomain.ngrok-free.app
ADMIN_WEBAPP_URL=https://your-domain/admin

# Notes:
# - Replace BOT_TOKEN with token from BotFather.
# - The default KIGM_MERCH_DB is for Docker. For local dev without Docker,
#   you might use: sqlite+aiosqlite:///./kigm_merch.db
# - Save as .env (do NOT commit real secrets).
